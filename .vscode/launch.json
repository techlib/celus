{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings.test"
      }
    },
    {
      "name": "Python Debugger: Django, port 8015",
      "type": "debugpy",
      "request": "launch",
      "args": ["runserver", "localhost:8015"],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/manage.py",
      "justMyCode": false,
      "env": {
        "DEBUG": "True",
        "DJANGO_SETTINGS_MODULE": "config.settings.devel"
      }
    },
    {
      "name": "Python Debugger: Celery Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A",
        "config",
        "worker",
        "-Q",
        "export,celery,interest,sushi,import,normal,preflight,ch_export",
        "--concurrency=1",
        "-l",
        "DEBUG"
      ],
      "env": {
        "DEBUG": "True",
        "DJANGO_SETTINGS_MODULE": "config.settings.devel"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
