{% load i18n %}
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text align="center" color="#555" />
      <mj-section background-color="#fff" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#fff">
    <mj-section>
      <mj-column>
        <mj-text>
          <p>{% blocktranslate with organization=organization %}Unfortunatelly your organization {{ organization }} doesn't have any credentials set up. In order to recieve harvest reports you need to create some credentials linked to the organization first.{% endblocktranslate %}</p>
          <p>{% translate 'If you are not sure how to create credentials within CELUS, you can check ' %} <a href="https://support.celus.net/support/solutions/articles/103000078036-adding-new-sushi-credentials">{% translate 'our documentation' %}</a>.</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey" />
    {% include 'sushi/email/_harvest_report_body_footer.mjml' %}

  </mj-body>

</mjml>
