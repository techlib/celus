{% load i18n %}
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text align="center" color="#555" />
      <mj-section background-color="#fff" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#fff">
    <mj-section>
      <mj-column border="1px solid #eee" border-radius="10px">
        <mj-text>
          <h3 style="margin-bottom: 0">{% blocktranslate with month=last_month|date:"F" %}New Issues - {{ month }} - Broken Credentials{% endblocktranslate %} ({{ newly_broken|length }})</h3>
          <p><i>{% translate 'New issues which appeared in the previous month.' %}</i></p>
        </mj-text>
{% if newly_broken|length %}
         <mj-table color="#555" align="center">
            <tr style="border-bottom: 1px solid #ddd">
                <th style="width: 33%; text-align: left">{% translate 'Organization' %}</th>
                <th style="width: 33%; text-align: left">{% translate 'Platform' %}</th>
                <th style="width: 33%; text-align: center">{% translate 'Counter Version' %}</th>
            </tr>
  {% for creds in newly_broken %}
            <tr>
                <td style="text-align: left; padding: 3px;">{{ creds.organization }}</td>
                <td style="text-align: left; padding: 3px;"><a href="{{ celus_url }}/admin/sushi-credentials?platformFilter={{ creds.platform.id }}&counterVersion={{ creds.counter_version }}">{{ creds.platform }}</a></td>
                <td style="text-align: center">{{ creds.counter_version_repr }}</td>
            </tr>
  {% endfor %}
         </mj-table>
{% else %}
         <mj-text>
           <p>{% blocktranslate with month=last_month|date:"F" %}No newly broken credentials in {{ month }}.{% endblocktranslate %}</p>
         </mj-text>
{% endif %}
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column border="1px solid #eee" border-radius="10px">
        <mj-text>
          <h3 style="margin-bottom: 0">{% translate 'Empty data' %} ({{ empty_data|length }})</h3>
          <p><i>{% blocktranslate with month=last_month|date:"F" %}Credentials for which empty data was harvested in {{ month }}.{% endblocktranslate %}</i></p>
        </mj-text>
{% if empty_data|length %}
         <mj-table color="#555" align="center">
            <tr style="border-bottom: 1px solid #ddd">
                <th style="width: 33%; text-align: left">{% translate 'Organization' %}</th>
                <th style="width: 33%; text-align: left">{% translate 'Platform' %}</th>
                <th style="width: 33%; text-align: center">{% translate 'Counter Version' %}</th>
            </tr>
  {% for creds in empty_data %}
            <tr>
                <td style="text-align: left; padding: 3px;">{{ creds.organization }}</td>
                <td style="text-align: left"><a href="{{ celus_url }}/admin/sushi-credentials?platformFilter={{ creds.platform.id }}&counterVersion={{ creds.counter_version }}">{{ creds.platform }}</a></td>
                <td style="text-align: center">{{ creds.counter_version_repr }}</td>
            </tr>
  {% endfor %}
         </mj-table>
{% else %}
         <mj-text>
           <p>{% blocktranslate with month=last_month|date:"F" %}No empty data downloaded in {{ month }}.{% endblocktranslate %}</p>
         </mj-text>
{% endif %}
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column border="1px solid #eee" border-radius="10px">
        <mj-text>
          <h3 style="margin-bottom: 0">{% blocktranslate with month=month|date:"F"|title %}{{ month }} Data Harvesting Success Rate{% endblocktranslate %}: {{ overall_success_rate|floatformat }} %</h3>
          <p>
            <i>{% blocktranslate with month=month|date:"F" last_month=last_month|date:"F" %}Percentage of {{ month }} usage successfully harvested in {{ last_month }}{% endblocktranslate %}</i>
          </p>
        </mj-text>
        <mj-table color="#555" align="center">
           <tr style="border-bottom: 1px solid #ddd">
               <th style="width: 50%; text-align: left">{% translate 'Organization' %}</th>
               <th style="width: 50%; text-align: center">{% translate 'Percentage' %}</th>
           </tr>
  {% for harvest_report in harvest_reports %}
           <tr>
               <td style="text-align: left">{{ harvest_report.organization }}</td>
               <td style="text-align: center">{{ harvest_report.success_rate|default:0|floatformat }} %</td>
           </tr>
  {% endfor %}
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column border="1px solid #eee" border-radius="10px">
        <mj-text>
          <h3 style="margin-bottom: 0">{% translate 'Potential Issues' %} ({{ issue_count }})</h3>
          <p><i>{% translate 'All potential issues - regardless of when they first appeared' %}</i></p>
        </mj-text>
         <mj-table color="#555" align="center">
            <tr style="border-bottom: 1px solid #ddd">
                <th style="width: 50%;text-align: left">{% translate 'Issue' %}</th>
                <th style="width: 50%;text-align: center">{% translate 'Count' %}</th>
            </tr>
            <tr>
                <td style="text-align: left">{% translate 'Broken Credentials' %}</td>
                <td style="text-align: center"><a href="{{ celus_url }}/admin/sushi-credentials?potentialIssuesFilter=broken">{{ broken_count }}</a></td>
            </tr>
            <tr>
                <td style="text-align: left">{% translate 'Unverified Credentials' %}</td>
                <td style="text-align: center"><a href="{{ celus_url }}/admin/sushi-credentials?potentialIssuesFilter=not_validated">{{ unverified_count }}</a></td>
            </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column border="1px solid #eee" border-radius="10px">
        <mj-text>
          <h3 style="margin-bottom: 0">{% blocktranslate with month=month|date:"F" %}Anomaly Data - {{ month }}{% endblocktranslate %} (<a href="{{ celus_url }}/analytics/anomaly-report?month={{ month|date:'Y-m' }}">{{ anomaly_count }}</a>)</h3>
          {% if anomaly_count %}
          <p><i>{% blocktranslate with month=month|date:"F" %}Anomalies found in {{ month }} data{% endblocktranslate %}</i></p>
        </mj-text>
        <mj-table color="#555" align="center">
          <tr style="border-bottom: 1px solid #ddd">
            <th style="width: 33%; text-align: left">{% translate 'Organization' %}</th>
            <th style="width: 33%; text-align: left">{% translate 'Platform' %}</th>
            <th style="width: 33%; text-align: center">{% translate 'Count' %}</th>
          </tr>
          {% for anomaly in anomaly_summary %}
          <tr>
            <td style="text-align: left; padding: 3px">{{ anomaly.organization_name }}</td>
            <td style="text-align: left; padding: 3px">{{ anomaly.platform_name }}</td>
            <td style="text-align: center"><a href="{{ celus_url }}/analytics/anomaly-report?month={{ month|date:'Y-m' }}&platformId={{ anomaly.platform_id }}">{{ anomaly.count }}</a></td>
          </tr>
          {% endfor %}
        </mj-table>
        {% else %}
        </mj-text>
        <mj-text>
          <p>{% blocktranslate with month=month|date:"F" %}No anomalies detected in {{ month }} data.{% endblocktranslate %}</p>
        </mj-text>
        {% endif %}
      </mj-column>
    </mj-section>

    <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey" />

    {% include 'sushi/email/_harvest_report_body_footer.mjml' %}
  </mj-body>
</mjml>
