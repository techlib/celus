#: apps/core/templates/account/email/email_confirmation_message.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"you are receiving this email in order to verify your email address for use "
"with CELUS.\n"
"\n"
"To confirm your email, please go to %(activate_url)s\n"
"\n"
"If you did not register your email with us, you can safely ignore this email "
"or reply to it to let us know about the situation.\n"
"\n"
"Have a great day\n"
"\n"
"The CELUS team\n"
msgstr ""
"Dobrý den,\n"
"\n"
"tento email jste obdržel(a) aby bylo možné ověřit vaši emailovou adresu v "
"CELUSU \n"
"\n"
"Pro ověření emailu, prosím otevřete následující odkaz %(activate_url)s\n"
"\n"
"Pokud jste u nás Váš email neregistroval můžete tento email ignorovat nebo "
"nám odepsat abychom tuto situaci vyřešili.\n"
"\n"
"Mějte se skvěle\n"
"\n"
"Tým CELUS\n"

#: apps/core/templates/account/email/email_confirmation_subject.txt:2
msgid ""
"\n"
"Please verify your email address for use with CELUS\n"
msgstr ""
"\n"
"Prosím ověřte vaši emailovou adresu v CELUSU\n"

